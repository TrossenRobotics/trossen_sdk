{
  "robot_name": "trossen_adamo_remote_leader",

  "lifecycle": { "enabled": true },

  "hardware": {
    "arms": {
      "leader_left": {
        "ip_address":   "192.168.1.3",
        "model":        "wxai_v0",
        "end_effector": "wxai_v0_leader"
      },
      "leader_right": {
        "ip_address":   "192.168.1.2",
        "model":        "wxai_v0",
        "end_effector": "wxai_v0_leader"
      }
    },
    "cameras": []
  },

  "producers": [
    {
      "type":            "trossen_arm",
      "hardware_id":     "leader_left",
      "stream_id":       "leader_left",
      "poll_rate_hz":    200.0,
      "use_device_time": false
    },
    {
      "type":            "trossen_arm",
      "hardware_id":     "leader_right",
      "stream_id":       "leader_right",
      "poll_rate_hz":    200.0,
      "use_device_time": false
    }
  ],

  "teleop": {
    "enabled": false,
    "rate_hz": 100.0,
    "pairs": []
  },

  "backend": {
    "root":             "~/.trossen_sdk",
    "dataset_id":       "adamo_leader_dataset",
    "compression":      "",
    "chunk_size_bytes": 4194304
  },

  "observers": [
    {
      "type":     "adamo",
      "id":       "adamo_leader_publisher",
      "robot":    "wxai",
      "protocol": "quic",
      "enabled":  true,
      "subscriptions": [
        { "record_id": "leader_left",  "throttle_hz": 200.0, "topic": "state" },
        { "record_id": "leader_right", "throttle_hz": 200.0, "topic": "state" }
      ]
    }
  ],

  "session": {
    "max_duration":   86400.0,
    "max_episodes":   1,
    "backend_type":   "null",
    "reset_duration": 0.0
  }
}
