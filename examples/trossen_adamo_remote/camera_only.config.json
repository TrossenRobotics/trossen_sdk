{
  "robot_name": "trossen_adamo_camera_test",

  "hardware": {
    "arms": {},
    "cameras": [
      {
        "id":            "camera_scene",
        "type":          "realsense_camera",
        "serial_number": "128422271347",
        "width":         640,
        "height":        480,
        "fps":           30,
        "use_depth":     false
      }
    ]
  },

  "producers": [
    {
      "type":            "realsense_camera",
      "hardware_id":     "camera_scene",
      "stream_id":       "camera_scene",
      "poll_rate_hz":    30.0,
      "encoding":        "bgr8",
      "use_device_time": true
    }
  ],

  "teleop": { "enabled": false, "rate_hz": 100.0, "pairs": [] },

  "backend": {
    "root":             "~/.trossen_sdk",
    "dataset_id":       "adamo_camera_test",
    "compression":      "",
    "chunk_size_bytes": 4194304
  },

  "observers": [
    {
      "type":     "adamo",
      "id":       "adamo_camera_test",
      "robot":    "wxai",
      "protocol": "quic",
      "enabled":  true,
      "subscriptions": [
        {
          "record_id":    "camera_scene",
          "throttle_hz":  15.0,
          "topic":        "camera",
          "track_name":   "scene",
          "width":        640,
          "height":       480,
          "fps":          15,
          "bitrate_kbps": 4000
        }
      ]
    }
  ],

  "session": {
    "max_duration":   86400.0,
    "max_episodes":   1,
    "backend_type":   "null",
    "reset_duration": 0.0
  }
}
