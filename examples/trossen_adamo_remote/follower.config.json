{
  "robot_name": "trossen_adamo_remote_follower",

  "hardware": {
    "arms": {
      "follower": {
        "ip_address":   "192.168.1.4",
        "model":        "wxai_v0",
        "end_effector": "wxai_v0_follower"
      }
    },
    "cameras": [
      { "id": "camera_high",        "type": "realsense_camera", "serial_number": "128422271347", "width": 640, "height": 480, "fps": 30, "use_depth": false },
      { "id": "camera_low",         "type": "realsense_camera", "serial_number": "218622270304", "width": 640, "height": 480, "fps": 30, "use_depth": false },
      { "id": "camera_left_wrist",  "type": "realsense_camera", "serial_number": "218622274938", "width": 640, "height": 480, "fps": 30, "use_depth": false },
      { "id": "camera_right_wrist", "type": "realsense_camera", "serial_number": "130322272628", "width": 640, "height": 480, "fps": 30, "use_depth": false }
    ]
  },

  "remote_leader_hardware": {
    "virtual_leader": {
      "type":            "remote_adamo_leader",
      "robot":           "wxai",
      "arm":             "leader",
      "protocol":        "quic",
      "api_key_env":     "ADAMO_API_KEY",
      "ready_timeout_s": 30.0
    }
  },

  "producers": [
    {
      "type":            "trossen_arm",
      "hardware_id":     "follower",
      "stream_id":       "follower",
      "poll_rate_hz":    100.0,
      "use_device_time": false
    },
    { "type": "realsense_camera", "hardware_id": "camera_high",        "stream_id": "camera_high",        "poll_rate_hz": 30.0, "encoding": "bgr8", "use_device_time": true },
    { "type": "realsense_camera", "hardware_id": "camera_low",         "stream_id": "camera_low",         "poll_rate_hz": 30.0, "encoding": "bgr8", "use_device_time": true },
    { "type": "realsense_camera", "hardware_id": "camera_left_wrist",  "stream_id": "camera_left_wrist",  "poll_rate_hz": 30.0, "encoding": "bgr8", "use_device_time": true },
    { "type": "realsense_camera", "hardware_id": "camera_right_wrist", "stream_id": "camera_right_wrist", "poll_rate_hz": 30.0, "encoding": "bgr8", "use_device_time": true }
  ],

  "teleop": {
    "enabled": true,
    "rate_hz": 100.0,
    "pairs": [
      { "leader": "virtual_leader", "follower": "follower" }
    ]
  },

  "backend": {
    "root":             "~/.trossen_sdk",
    "dataset_id":       "adamo_follower_dataset",
    "compression":      "",
    "chunk_size_bytes": 4194304
  },

  "observers": [
    {
      "type":     "adamo",
      "id":       "adamo_follower_publisher",
      "robot":    "wxai",
      "protocol": "quic",
      "enabled":  true,
      "subscriptions": [
        {
          "record_id":   "follower",
          "throttle_hz": 100.0,
          "topic":       "effort"
        },
        { "record_id": "camera_high",        "throttle_hz": 15.0, "topic": "camera", "track_name": "high",        "width": 640, "height": 480, "fps": 15, "bitrate_kbps": 4000 },
        { "record_id": "camera_low",         "throttle_hz": 15.0, "topic": "camera", "track_name": "low",         "width": 640, "height": 480, "fps": 15, "bitrate_kbps": 4000 },
        { "record_id": "camera_left_wrist",  "throttle_hz": 15.0, "topic": "camera", "track_name": "left_wrist",  "width": 640, "height": 480, "fps": 15, "bitrate_kbps": 4000 },
        { "record_id": "camera_right_wrist", "throttle_hz": 15.0, "topic": "camera", "track_name": "right_wrist", "width": 640, "height": 480, "fps": 15, "bitrate_kbps": 4000 }
      ]
    }
  ],

  "session": {
    "max_duration":   86400.0,
    "max_episodes":   1,
    "backend_type":   "null",
    "reset_duration": 0.0
  }
}
