{
  "robot_name": "trossen_rivet",

  "hardware": {
    "bimanual_arms": {
      "bimanual_glide": {
        "left_ip_address": "192.168.0.3",
        "left_model": "glide_left",
        "right_ip_address": "192.168.0.2",
        "right_model": "glide_right",
        "joint_signs": [1,1,1,-1,-1,1,1],
        "left_joint_offsets": [0,0,0,0,0,-0.7854,0],
        "right_joint_offsets": [0,0,0,0,0,0.7854,0],
        "velocity_tolerance": [9.42, 9.42, 9.42, 9.42, 9.42, 9.42, 0.0],
        "effort_tolerance": [7.0, 7.0, 7.0, 7.0, 7.0, 7.0, 300.0]
      }
    },
    "mobile_rivet": {
      "rivet": {
        "left_ip_address": "192.168.1.4",
        "left_model": "pro",
        "right_ip_address": "192.168.1.5",
        "right_model": "pro",
        "velocity_tolerance": [6.28, 6.28, 6.28, 9.42, 9.42, 9.42, 0.0],
        "effort_tolerance": [27.0, 97.0, 27.0, 7.0, 7.0, 7.0, 300.0]
      }
    },
    "cameras": [
    ]
  },

  "teleop": {
    "enabled": true,
    "rate_hz": 1000.0,
    "pairs": [
      { "leader": "bimanual_glide",  "follower": "rivet"  }
    ]
  },

  "producers": [
    {
      "type": "rivet",
      "hardware_id": "rivet",
      "stream_id": "rivet",
      "poll_rate_hz": 30.0,
      "use_device_time": false
    }
  ],

  "observers": [
    {
      "type":      "rerun",
      "id":        "live_viewer",
      "app_id":    "trossen_rivet",
      "spawn":     true,
      "enabled":   true,
      "subscriptions": [
        { "record_id": "camera_left",  "throttle_hz": 15.0 },
        { "record_id": "camera_right", "throttle_hz": 15.0 }
      ]
    }
  ],

  "backend": {
    "root": "~/sdk_output",
    "dataset_id": "rivet_dataset"
  }

}
