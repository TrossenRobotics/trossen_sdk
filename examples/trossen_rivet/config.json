{
  "robot_name": "trossen_rivet",

  "hardware": {
    "bimanual_arms": {
      "bimanual_glide": {
        "left_ip_address": "192.168.0.3",
        "left_model": "glide_left",
        "right_ip_address": "192.168.0.2",
        "right_model": "glide_right",
        "write_moving_time_s": 0.2,
        "joint_signs": [1,1,1,-1,-1,1,1],
        "left_joint_offsets": [0,0,0,0,0,-0.7854,0],
        "right_joint_offsets": [0,0,0,0,0,0.7854,0]
      }
    },
    "mobile_rivet": {
      "rivet": {
        "left_ip_address": "192.168.1.4",
        "left_model": "pro",
        "right_ip_address": "192.168.1.5",
        "right_model": "pro",
        "write_moving_time_s": 0.2,
        "staging_time_s": 2.0
      }
    },
    "cameras": [
      {
        "id":            "camera_left",
        "type":          "zed_camera",
        "serial_number": "97900849",
        "resolution":    "HD1200",
        "fps":           30,
        "use_depth":     false
      },
      {
        "id":            "camera_right",
        "type":          "zed_camera",
        "serial_number": "97525506",
        "resolution":    "HD1200",
        "fps":           30,
        "use_depth":     false
      }
    ]
  },

  "teleop": {
    "enabled": true,
    "rate_hz": 1000.0,
    "pairs": [
      { "leader": "bimanual_glide",  "follower": "rivet"  }
    ]
  },

  "producers": [
    {
      "type": "rivet",
      "hardware_id": "rivet",
      "stream_id": "rivet",
      "poll_rate_hz": 30.0,
      "use_device_time": false
    },
    {
      "type":            "zed_camera",
      "hardware_id":     "camera_left",
      "stream_id":       "camera_left",
      "poll_rate_hz":    30.0,
      "encoding":        "bgr8",
      "use_device_time": true
    },
    {
      "type":            "zed_camera",
      "hardware_id":     "camera_right",
      "stream_id":       "camera_right",
      "poll_rate_hz":    30.0,
      "encoding":        "bgr8",
      "use_device_time": true
    }
  ],

  "observers": [
    {
      "type":      "rerun",
      "id":        "live_viewer",
      "app_id":    "trossen_rivet",
      "spawn":     true,
      "enabled":   true,
      "subscriptions": [
        { "record_id": "camera_left",  "throttle_hz": 15.0 },
        { "record_id": "camera_right", "throttle_hz": 15.0 }
      ]
    }
  ],

  "backend": {
    "root": "~/sdk_output",
    "dataset_id": "rivet_dataset"
  }

}
