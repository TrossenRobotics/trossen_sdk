# Copy to .env and edit before `docker compose up`.

# Password for the admin console login. Change from the default.
HUB_ADMIN_PASSWORD=change-me

# Shared secret every collection machine must present to register with the
# hub. Generate one, e.g.:  openssl rand -hex 24
# Put the SAME value in each machine's HUB_TOKEN.
HUB_TOKEN=

# Stable cookie-signing secret so admin logins survive a hub restart.
# Generate one, e.g.:  openssl rand -hex 32
HUB_SECRET=

# Set to empty to disable uvicorn hot-reload.
UVICORN_RELOAD=1
