{
  "name": "Trossen Solo Glide",
  "config": {
    "robot_name": "trossen_solo_glide",
    "hardware": {
      "arms": {
        "glide": {
          "ip_address": "192.168.0.3",
          "model": "glide_right",
          "end_effector": "wxai_v0_leader",
          "joint_signs": [
            1,
            1,
            1,
            -1,
            -1,
            1,
            1
          ],
          "joint_offsets": [
            0,
            0,
            0,
            0,
            0,
            -0.7854,
            0
          ],
          "gripper_feedback_leader_max": 20.0,
          "gripper_feedback_follower_max": 100.0,
          "gripper_feedback_offset": 6.5,
          "gripper_feedback_mode": "effort",
          "actuated": false,
          "gripper_force_feedback": true
        },
        "follower": {
          "ip_address": "192.168.1.4",
          "model": "pro",
          "end_effector": "pro_base",
          "write_moving_time_s": 0.0,
          "smoothing_enabled": true,
          "smoothing_gripper": false,
          "smoothing_min_cutoff_hz": 1.0,
          "smoothing_beta": 0.9,
          "smoothing_d_cutoff_hz": 1.0,
          "staging_time_s": 2.0,
          "command_position_min": [
            -0.8,
            null,
            null,
            null,
            null,
            null,
            null
          ],
          "command_position_max": [
            1.1,
            null,
            null,
            null,
            null,
            null,
            null
          ]
        }
      },
      "components": [
        {
          "id": "glide_inputs",
          "type": "glide_arm_input",
          "arms": [
            "glide"
          ]
        },
        {
          "id": "session_control",
          "type": "glide_session_control",
          "poll_rate_hz": 50.0,
          "debounce_ms": 40,
          "buttons": [
            {
              "arm_id": "glide",
              "bit": 0,
              "event": "start"
            },
            {
              "arm_id": "glide",
              "bit": 1,
              "event": "stop_session"
            },
            {
              "arm_id": "glide",
              "bit": 2,
              "event": "rerecord"
            }
          ]
        }
      ],
      "cameras": [
        {
          "id": "camera_main",
          "type": "realsense_camera",
          "serial_number": "128422271347",
          "width": 640,
          "height": 480,
          "fps": 30
        },
        {
          "id": "camera_wrist",
          "type": "realsense_camera",
          "serial_number": "218622270304",
          "width": 640,
          "height": 480,
          "fps": 30
        }
      ]
    },
    "teleop": {
      "enabled": true,
      "rate_hz": 1000.0,
      "pairs": [
        {
          "leader": "glide",
          "follower": "follower",
          "space": "joint"
        }
      ]
    },
    "producers": [
      {
        "type": "trossen_arm",
        "hardware_id": "follower",
        "stream_id": "follower",
        "poll_rate_hz": 30.0,
        "use_device_time": false
      },
      {
        "type": "trossen_arm",
        "hardware_id": "glide",
        "stream_id": "glide",
        "poll_rate_hz": 30.0,
        "use_device_time": false
      },
      {
        "type": "realsense_camera",
        "hardware_id": "camera_main",
        "stream_id": "camera_main",
        "poll_rate_hz": 30.0,
        "encoding": "bgr8",
        "use_device_time": true
      },
      {
        "type": "realsense_camera",
        "hardware_id": "camera_wrist",
        "stream_id": "camera_wrist",
        "poll_rate_hz": 30.0,
        "encoding": "bgr8",
        "use_device_time": true
      }
    ],
    "backend": {
      "root": "~/trossen_data",
      "dataset_id": "solo_glide_dataset",
      "compression": "",
      "chunk_size_bytes": 4194304
    },
    "session": {
      "max_duration": 50.0,
      "max_episodes": 40,
      "backend_type": "trossen_mcap",
      "reset_duration": 5.0
    }
  }
}
