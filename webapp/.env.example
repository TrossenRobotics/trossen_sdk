# Copy to webapp/.env and edit before `docker compose up`.
# Every value is optional — with none set, the machine runs fully standalone
# (the default), exactly as before the fleet hub existed.

# --- Fleet hub (webapp/hub) ---------------------------------------------------
# To have this collection machine join a central admin console, point it at the
# hub and share the hub's token. Leave HUB_URL empty to stay standalone (the
# machine then never dials out).
#
#   HUB_URL   — the hub's WebSocket/base URL. http(s):// is auto-normalised to
#               ws(s)://, and /ws/machine is appended if missing. Use the hub
#               box's LAN IP (not localhost) from another machine.
#   HUB_TOKEN — must match the hub's HUB_TOKEN exactly, or registration is
#               rejected. Generate on the hub with: openssl rand -hex 24
#   MACHINE_NAME — optional friendly label on the dashboard (defaults to the
#               machine's hostname). e.g. Cell-A.
HUB_URL=
HUB_TOKEN=
MACHINE_NAME=

# --- Local dev knobs ----------------------------------------------------------
# uvicorn hot-reload (backend). ON by default so the in-app Update button's git
# pull takes effect without a restart. Set empty to disable.
UVICORN_RELOAD=1

# Build the backend image with ZED SDK support (heavier base + GPU at runtime;
# see docker-compose.zed.yml). Off by default.
ENABLE_ZED=0
